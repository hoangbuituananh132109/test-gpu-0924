# Two-step, 1024-token memory/throughput probe for the proposed larger pair.
# Paths must be checked against actual offline assets before use.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/config_a30_4gpu_smoke.env"
STUDENT_MODEL=/shared-storage/models/Qwen3-4B
TEACHER_MODEL=/shared-storage/models/Qwen3-8B
GPU_MEMORY_UTILIZATION=0.25
TRAIN_VARIANT=a30_4gpu_qwen3_4b_8b_feasibility_g4_1024
