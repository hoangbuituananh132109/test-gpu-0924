# Two-step systems smoke only. It is not a scientific 7k result.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/config_b200_8gpu.env"
TRAIN_VARIANT=b200_8gpu_smoke2_b16_m16_g4_1k_e5_v4
MAX_RESP_LENGTH=1024
MAX_VAL_RESP_LENGTH=1024
PPO_MAX_TOKEN_LEN_PER_GPU=4096
