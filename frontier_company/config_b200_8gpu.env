# One-node 8xB200 profile for the matched Qwen3-1.7B-Instruct E5-v4 cell.
# Paths may be overridden in the environment before launching.
N_GPUS=${N_GPUS:-8}
SEED=${SEED:-42}
N_RESPONSES=${N_RESPONSES:-4}
MAX_PROMPT_LENGTH=${MAX_PROMPT_LENGTH:-1024}
MAX_RESP_LENGTH=${MAX_RESP_LENGTH:-7168}
MAX_VAL_RESP_LENGTH=${MAX_VAL_RESP_LENGTH:-7168}

# 16 prompts -> 64 rollouts/step at G=4 -> 8 rollouts per GPU.
TRAIN_BATCH_SIZE=${TRAIN_BATCH_SIZE:-16}
MINI_BATCH_SIZE=${MINI_BATCH_SIZE:-16}
PPO_MICRO_BATCH_SIZE_PER_GPU=${PPO_MICRO_BATCH_SIZE_PER_GPU:-2}
PPO_MAX_TOKEN_LEN_PER_GPU=${PPO_MAX_TOKEN_LEN_PER_GPU:-16384}
REF_LOG_PROB_MICRO_BATCH_SIZE_PER_GPU=${REF_LOG_PROB_MICRO_BATCH_SIZE_PER_GPU:-2}
REWARD_MICRO_BATCH_SIZE_PER_GPU=${REWARD_MICRO_BATCH_SIZE_PER_GPU:-2}
GPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.70}

MODEL_DTYPE=bfloat16
LR=${LR:-1e-6}
PPO_EPOCHS=${PPO_EPOCHS:-1}
TOTAL_EPOCHS=${TOTAL_EPOCHS:-1}
SAVE_FREQ=${SAVE_FREQ:-8}
MAX_ACTOR_CKPT_TO_KEEP=${MAX_ACTOR_CKPT_TO_KEEP:-2}
TEST_FREQ=-1
VAL_N=4
TEMPERATURE=1.0
ROLLOUT_TOP_P=1.0
VAL_TEMPERATURE=0.7
VAL_TOP_P=0.95
REPETITION_PENALTY=1.0
LOG_PROB_TOP_K=16
TOP_K_STRATEGY=only_stu
REWARD_WEIGHT_MODE=student_p
TEACHER_TEMPERATURE=1.0

# B200 has enough memory to keep all branches resident. These are systems
# settings only; student, teacher, loss definitions and rollout policy remain BF16.
ACTOR_PARAM_OFFLOAD=false
ACTOR_OPTIMIZER_OFFLOAD=false
TEACHER_PARAM_OFFLOAD=false
REF_PARAM_OFFLOAD=false
ENABLE_GRADIENT_CHECKPOINTING=true
ENABLE_ACTIVATION_OFFLOAD=false
ACTOR_FSDP_STRATEGY=fsdp2
ACTOR_FSDP_OFFLOAD_POLICY=false
REWARD_FSDP_STRATEGY=fsdp2
ROLLOUT_REPEAT_INTERLEAVE=false
FRONTIER_TEACHER_ENTROPY_CHUNK_SIZE=${FRONTIER_TEACHER_ENTROPY_CHUNK_SIZE:-4096}

# "auto" selects FlashAttention2 + remove-padding when flash_attn is installed;
# otherwise it selects PyTorch SDPA without remove-padding.
ATTN_IMPLEMENTATION=${ATTN_IMPLEMENTATION:-auto}
USE_REMOVE_PADDING=${USE_REMOVE_PADDING:-auto}

ENABLE_THINKING=true
TRAIN_VARIANT=${TRAIN_VARIANT:-b200_8gpu_instruct_think_pilot512_b16_m16_g4_7k_e5_v4}
UPSTREAM_ROOT=${UPSTREAM_ROOT:-$PROJECT_ROOT}
RUNS_ROOT=${RUNS_ROOT:-/shared-storage/models/opd-grpo-frontier-runs}
TRAIN_DATASET=${TRAIN_DATASET:-/shared-storage/models/dapo_processed_pilot_512.parquet}
VAL_DATASET=${VAL_DATASET:-$TRAIN_DATASET}
STUDENT_MODEL=${STUDENT_MODEL:-/shared-storage/models/Qwen3-1.7B}
TEACHER_MODEL=${TEACHER_MODEL:-/shared-storage/models/Qwen3-4B-Base-GRPO}
EXPECTED_TRAIN_ROWS=${EXPECTED_TRAIN_ROWS:-512}
PROJECT_NAME=FrontierGRPOOPD
ENABLE_GPU_TELEMETRY=true
GPU_TELEMETRY_INTERVAL=2

FRONTIER_GRPO_GAMMA=1.0
FRONTIER_GRPO_MIN=0.0
FRONTIER_GRPO_MAX=1.0
FRONTIER_OPD_TAU_C=0.5
FRONTIER_OPD_KAPPA=0.1
FRONTIER_OPD_MIN=0.0
FRONTIER_OPD_MAX=1.0
QUEUE_SAMPLER_CLASS_PATH=pkg://frontier.verl_zero_defer_sampler
QUEUE_SAMPLER_CLASS_NAME=ZeroDeferCurriculumSampler
QUEUE_MAX_TOTAL_REVISITS=512

# Sparse diagnostics only; they do not change either loss branch.
FRONTIER_GRAD_DIAG_ENABLE=true
FRONTIER_GRAD_DIAG_INTERVAL=8
FRONTIER_GRAD_DIAG_FIRST_STEP=8
FRONTIER_GRAD_DIAG_MIN_PARAM_NUMEL=100000
FRONTIER_GRAD_DIAG_MAX_PARAM_NUMEL=80000000
