# Offline one-node 4xA30 systems profile. This is NOT a new scientific baseline.
# For a comparable study, freeze this file, data hash and model hashes for all arms.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/config_b200_8gpu.env"

N_GPUS=4
MAX_PROMPT_LENGTH=1024
MAX_RESP_LENGTH=7168
MAX_VAL_RESP_LENGTH=7168
N_RESPONSES=4
TRAIN_BATCH_SIZE=4
MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE_PER_GPU=1
PPO_MAX_TOKEN_LEN_PER_GPU=8192
REF_LOG_PROB_MICRO_BATCH_SIZE_PER_GPU=1
REWARD_MICRO_BATCH_SIZE_PER_GPU=1
GPU_MEMORY_UTILIZATION=0.30
ACTOR_PARAM_OFFLOAD=true
ACTOR_OPTIMIZER_OFFLOAD=true
TEACHER_PARAM_OFFLOAD=true
REF_PARAM_OFFLOAD=true
ENABLE_GRADIENT_CHECKPOINTING=true
ENABLE_ACTIVATION_OFFLOAD=true
ACTOR_FSDP_STRATEGY=fsdp2
ACTOR_FSDP_OFFLOAD_POLICY=true
REWARD_FSDP_STRATEGY=fsdp2
FRONTIER_MANAGE_RAY=false
FRONTIER_GRAD_DIAG_ENABLE=false
TRAIN_VARIANT=a30_4gpu_qwen3_1p7b_to_4b_instruct_think_1024_b4_g4_7k
TRAIN_DATASET=/shared-storage/models/dapo_processed_pilot_1024.parquet
VAL_DATASET=$TRAIN_DATASET
EXPECTED_TRAIN_ROWS=1024
STUDENT_MODEL=/shared-storage/models/Qwen3-1.7B
TEACHER_MODEL=/shared-storage/models/Qwen3-4B
RUNS_ROOT=${RUNS_ROOT:-/shared-storage/models/opd-grpo-frontier-runs}

# This profile is conservative. Raise vLLM utilization/batch only after
# measuring free VRAM and phase times; never alter one comparison arm alone.
